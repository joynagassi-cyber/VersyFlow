# VersyFlow — CI/CD secrets reference (TEMPLATE ONLY — no values in the repo)
#
# This file mirrors the secrets consumed by .github/workflows/ci-cd.yml.
# It is a reference for local .env.local alignment and for the checklist in
# .github/secrets-checklist.md. It contains NO real values — real values are
# stored exclusively in GitHub Settings → Secrets and variables → Actions.
#
#   - Copy the VITE_* block into your LOCAL .env.local for development.
#   - Create the remaining entries as GITHUB SECRETS (repo or environment
#     scope "production") — never commit real values.
#
# Required GitHub repo secrets (exactly these 7, consumed by ci-cd.yml):
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_POWERSYNC_URL,
#   KEYSTORE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD
#
# DAG in ci-cd.yml (no web deploy step):
#   quality-gate (typecheck | lint | tests)
#     -> build-web
#     -> { build-android (debug APK) ,
#          build-android-release (signed APK, environment: production) }
#
# Triggers:
#   - push main/develop + PR to main: gates + build-web + debug APK
#   - push main: additionally the signed release APK
#   - workflow_dispatch inputs: build_release, version
#
# All lines below are safe to commit: placeholders only.

# ---------------------------------------------------------------------------
# Vite build-time env — workflow-level `env:` in ci-cd.yml
# (baked into the bundle at build time via import.meta.env)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co        # Supabase project URL
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key # anon key ONLY — never the service role key
VITE_POWERSYNC_URL=https://your-project.powersync.supabase.co

# ---------------------------------------------------------------------------
# Android release signing — consumed by build-android-release only
# (decoded on the runner; appended to android/gradle.properties at build time)
# ---------------------------------------------------------------------------
KEYSTORE=  # base64 of keystore/release.keystore — see .github/secrets-checklist.md "Keystore setup"
KEYSTORE_PASSWORD=            # keytool -storepass
KEY_ALIAS=versyflow-release-key   # keytool -alias (default convention)
KEY_PASSWORD=                 # keytool -keypass (often = KEYSTORE_PASSWORD)

# ---------------------------------------------------------------------------
# Backend-only — NOT consumed by ci-cd.yml; manual Supabase CLI work only.
# High privilege: keep out of any CI build job.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=  # service-role key — manual `supabase db push` only
