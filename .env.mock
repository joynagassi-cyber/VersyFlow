# VersyFlow — frontend-only ("mock") environment
# Loaded by `npm run dev:mock` (vite --mode mock) and by `vite --mode mock`.
#
# Nothing here talks to Supabase/PowerSync: the app runs entirely on the
# in-browser mock database, without sending test events to the local API.

VITE_DATA_MODE=mock

# Local test API endpoints (kept for compatibility). Collection is forcibly
# disabled by the application in demo mode.
VITE_MOCK_API_URL=/api
VITE_MOCK_DASHBOARD_URL=/mock-dashboard/

# Collection is forcibly disabled by the app during the demo chantier.
VITE_MOCK_API=off

# Garde-fou réseau : en mode mock, toute requête vers une autre origine est
# bloquée et journalisée (voir src/dev/network-guard.ts). Mettre "off" pour
# déboguer une ressource distante — jamais en démonstration.
VITE_MOCK_NET_GUARD=on
