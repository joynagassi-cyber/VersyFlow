# VersyFlow — frontend-only ("mock") environment
# Loaded by `npm run dev:mock` (vite --mode mock) and by `vite --mode mock`.
#
# Nothing here talks to Supabase/PowerSync: the app runs entirely on the
# in-browser mock database, and mirrors test events to the local API.

VITE_DATA_MODE=mock

# Local test API (see server/mock-api.mjs). Relative by default: Vite proxies
# /api and /mock-dashboard to http://127.0.0.1:4000 (same origin → works
# behind the HTTPS preview proxy too).
VITE_MOCK_API_URL=/api
VITE_MOCK_DASHBOARD_URL=/mock-dashboard/

# Set to "off" to disable event collection entirely.
VITE_MOCK_API=on
