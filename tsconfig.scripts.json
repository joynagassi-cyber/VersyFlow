{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/components/*"],
      "@/domains/*": ["src/domains/*"],
      "@/services/*": ["src/services/*"],
      "@/store/*": ["src/store/*"],
      "@/tokens": ["src/tokens/index"],
      "@/i18n": ["src/i18n/index"],
      "@/infrastructure/*": ["src/infrastructure/*"],
      "@/utils/*": ["src/utils/*"],
      "@/hooks/*": ["src/hooks/*"],
      "@/app": ["app"],
      "@/app/*": ["app/*"]
    }
  },
  "include": ["src", "app", "scripts", "env.d.ts"]
}

