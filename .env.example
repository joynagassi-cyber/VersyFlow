# VersyFlow — environment
#
# There is no backend to configure. The app runs entirely on the device:
# Bible JSON is bundled, themes and images are bundled, and every write goes to
# the browser's localStorage. No server URL, no API key, no sync endpoint.

# Data scope (optional).
#   mock  → the demo scope: fictitious data, isolated from your real data.
#   live  → your own local data on this device.
# Leave unset to open in demo mode.
VITE_DATA_MODE=mock

# Set to `off` (or `live`) to open on the real local data by default.
# VITE_DEMO_DEFAULT=off
