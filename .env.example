# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PowerSync (configure when ready)
# POWERSYNC_URL=https://your-powersync.supabase.run
# POWERSYNC_SECRET=your-powersync-secret

# PowerSync Cloud PAT — consumed ONLY by the PowerSync CLI on the developer
# machine (link cloud / pull / deploy). Real value lives in .env.local +
# the GitHub repo secret `PS_ADMIN_TOKEN`. CI/CD does NOT consume it.
# PS_ADMIN_TOKEN=

# InsForge (OBSOLETE)
# INSFORGE_URL=https://wypi8tgf.eu-central.insforge.app

# ---------------------------------------------------------------------------
# Data mode — "mock" (frontend only, no backend) or "live" (Supabase+PowerSync)
# ---------------------------------------------------------------------------
# Leave unset to auto-detect: "mock" when no Supabase credentials are set,
# "live" otherwise. Override per session with ?data=mock or the /dev panel.
# VITE_DATA_MODE=mock

# Base URL of the local test collector (server/mock-api.mjs). Relative by
# default so Vite proxies it (same-origin, works behind HTTPS previews).
# VITE_MOCK_API_URL=/api
# VITE_MOCK_DASHBOARD_URL=/mock-dashboard/
# VITE_MOCK_API=off   # disable test-event collection entirely
